{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packingproof.dev/schemas/extension.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "publisherId",
    "name",
    "summary",
    "description",
    "type",
    "repository",
    "license",
    "releaseSources"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "id": {"$ref": "common.v1.schema.json#/$defs/identifier"},
    "publisherId": {"$ref": "common.v1.schema.json#/$defs/publisherIdentifier"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "summary": {"type": "string", "minLength": 1, "maxLength": 160},
    "description": {"type": "string", "minLength": 1, "maxLength": 4000},
    "type": {"enum": ["userscript", "external-adapter"]},
    "repository": {"$ref": "common.v1.schema.json#/$defs/repository"},
    "homepage": {"$ref": "common.v1.schema.json#/$defs/httpsUrl"},
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "sourceUrl"],
      "properties": {
        "spdx": {"type": "string", "minLength": 2, "maxLength": 100},
        "sourceUrl": {"$ref": "common.v1.schema.json#/$defs/httpsUrl"}
      }
    },
    "categories": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9-]{2,32}$"},
      "uniqueItems": true,
      "maxItems": 8
    },
    "icon": {
      "type": "string",
      "pattern": "^assets/[A-Za-z0-9_.-]+\\.(png|webp)$",
      "maxLength": 200
    },
    "releaseSources": {
      "type": "array",
      "items": {"$ref": "common.v1.schema.json#/$defs/repository"},
      "minItems": 1,
      "maxItems": 2
    }
  }
}
