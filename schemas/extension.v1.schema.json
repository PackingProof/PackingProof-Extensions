{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packingproof.dev/schemas/extension.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "publisherId",
    "name",
    "summary",
    "description",
    "type",
    "license",
    "releaseSources"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "id": {"$ref": "common.v1.schema.json#/$defs/identifier"},
    "publisherId": {"$ref": "common.v1.schema.json#/$defs/publisherIdentifier"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "summary": {"type": "string", "minLength": 1, "maxLength": 160},
    "description": {"type": "string", "minLength": 1, "maxLength": 4000},
    "type": {"enum": ["userscript", "external-adapter"]},
    "repository": {"$ref": "common.v1.schema.json#/$defs/repository"},
    "homepage": {"$ref": "common.v1.schema.json#/$defs/httpsUrl"},
    "license": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "sourceUrl"],
          "properties": {
            "spdx": {"type": "string", "minLength": 2, "maxLength": 100},
            "sourceUrl": {"$ref": "common.v1.schema.json#/$defs/httpsUrl"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "termsUrl"],
          "properties": {
            "name": {"type": "string", "minLength": 2, "maxLength": 100},
            "termsUrl": {"$ref": "common.v1.schema.json#/$defs/httpsUrl"}
          }
        }
      ]
    },
    "sourceAvailability": {"enum": ["open-source", "closed-source"]},
    "categories": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9-]{2,32}$"},
      "uniqueItems": true,
      "maxItems": 8
    },
    "icon": {
      "type": "string",
      "pattern": "^assets/[A-Za-z0-9_.-]+\\.(png|webp)$",
      "maxLength": 200
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "sha256", "size", "alt"],
        "properties": {
          "url": {"$ref": "common.v1.schema.json#/$defs/httpsUrl"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 1, "maximum": 4194304},
          "alt": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S"}
        }
      },
      "minItems": 1,
      "maxItems": 6
    },
    "releaseSources": {
      "type": "array",
      "items": {"$ref": "common.v1.schema.json#/$defs/repository"},
      "minItems": 1,
      "maxItems": 2
    },
    "historicalReleaseSources": {
      "type": "array",
      "items": {"$ref": "common.v1.schema.json#/$defs/repository"},
      "minItems": 1,
      "maxItems": 8
    }
  }
}
