{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packingproof.dev/schemas/registry-extension.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "extension", "publisher", "trust", "versions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "extension": {"$ref": "extension.v1.schema.json"},
    "publisher": {"$ref": "publisher.v1.schema.json"},
    "trust": {"enum": ["official", "third-party"]},
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["release", "status", "advisory"],
        "properties": {
          "release": {"$ref": "version.v1.schema.json"},
          "status": {"enum": ["available", "withdrawn"]},
          "advisory": {
            "oneOf": [
              {"$ref": "advisory.v1.schema.json"},
              {"type": "null"}
            ]
          }
        }
      }
    }
  }
}
