{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packingproof.dev/schemas/version.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "extensionId",
    "version",
    "publishedAt",
    "source",
    "downloads",
    "sha256",
    "size",
    "compatibility",
    "access"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "extensionId": {"$ref": "common.v1.schema.json#/$defs/identifier"},
    "version": {"$ref": "common.v1.schema.json#/$defs/extensionVersion"},
    "publishedAt": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit"],
      "properties": {
        "tag": {"type": "string", "minLength": 1, "maxLength": 128},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "downloads": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary"],
          "properties": {
            "primary": {"$ref": "common.v1.schema.json#/$defs/download"},
            "mirror": {"$ref": "common.v1.schema.json#/$defs/download"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "gitee": {"$ref": "common.v1.schema.json#/$defs/download"},
            "github": {"$ref": "common.v1.schema.json#/$defs/download"}
          }
        }
      ]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size": {"type": "integer", "minimum": 1, "maximum": 209715200},
    "compatibility": {"$ref": "common.v1.schema.json#/$defs/compatibility"},
    "access": {"$ref": "common.v1.schema.json#/$defs/access"}
  }
}
