{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packingproof.dev/schemas/advisory.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "extensionId",
    "version",
    "status",
    "reasonCode",
    "message",
    "replacedBy",
    "withdrawnAt"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "extensionId": {"$ref": "common.v1.schema.json#/$defs/identifier"},
    "version": {"$ref": "common.v1.schema.json#/$defs/extensionVersion"},
    "status": {"const": "withdrawn"},
    "reasonCode": {"enum": ["security", "broken", "license", "unavailable", "other"]},
    "message": {"type": "string", "minLength": 1, "maxLength": 1000},
    "replacedBy": {
      "oneOf": [
        {"$ref": "common.v1.schema.json#/$defs/extensionVersion"},
        {"type": "null"}
      ]
    },
    "withdrawnAt": {"type": "string", "format": "date-time"}
  }
}
